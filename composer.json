{
    "name": "jocotoco/audio-api",
    "description": "API PHP para la recepcion de grabaciones de audio desde dispositivos Raspberry Pi autenticados con mTLS (step-ca)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Jocotoco\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jocotoco\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php bin/jocotoco migrate",
        "serve": "php -S 127.0.0.1:8080 -t public"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
