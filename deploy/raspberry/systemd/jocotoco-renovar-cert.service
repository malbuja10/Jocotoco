[Unit]
Description=Renovar el certificado de dispositivo con step-ca
Documentation=https://smallstep.com/docs/step-cli/reference/ca/renew
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=STEPPATH=/etc/jocotoco/step
# Valor por defecto; dispositivo.env lo sobreescribe con "vigencia - 30
# dias", que es lo que hace que el certificado se cambie cada 30 dias (lo
# calcula el bootstrap a partir del certificado emitido).
Environment=JOCOTOCO_RENOVAR_ANTES=8h
EnvironmentFile=-/etc/jocotoco/dispositivo.env
# Renueva solo si al certificado le queda menos de ese margen, asi que el
# temporizador puede dispararse a menudo sin cambiar el certificado a
# menudo: comprueba cada 4 h y renueva cada 30 dias. Esos intentos de mas
# son los que permiten que un equipo que estuvo semanas sin enlace se
# ponga al dia en su primera ventana de conexion.
ExecStart=/usr/bin/step ca renew --force --expires-in ${JOCOTOCO_RENOVAR_ANTES} \
    /etc/jocotoco/tls/dispositivo.crt /etc/jocotoco/tls/dispositivo.key
ExecStartPost=/bin/chmod 0644 /etc/jocotoco/tls/dispositivo.crt
ExecStartPost=/bin/chmod 0600 /etc/jocotoco/tls/dispositivo.key
