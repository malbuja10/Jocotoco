[Unit]
Description=Comprueba cada 4 h el certificado del dispositivo (lo renueva cada 30 dias)

[Timer]
OnBootSec=2min
OnUnitActiveSec=4h
RandomizedDelaySec=15min
# Si la Raspberry estuvo apagada, renueva en el siguiente arranque.
Persistent=true
Unit=jocotoco-renovar-cert.service

[Install]
WantedBy=timers.target
