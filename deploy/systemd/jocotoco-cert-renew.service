[Unit]
Description=Renovacion del certificado TLS del API Jocotoco (step-ca)
Documentation=https://smallstep.com/docs/step-cli/reference/ca/renew
After=network-online.target

[Service]
Type=oneshot
Environment=STEPPATH=/root/.step
# Valor de respaldo; 03-emitir-cert-servidor.sh escribe en este archivo
# "vigencia - 30 dias", que es lo que hace que el certificado se cambie
# cada 30 dias.
Environment=JOCOTOCO_RENOVAR_ANTES=8h
EnvironmentFile=-/etc/jocotoco/cert-renew.env
# --expires-in: renueva solo si le queda menos de ese margen. El
# temporizador puede dispararse cada 8 h sin cambiar el certificado cada
# 8 h: comprueba seguido y renueva cada 30 dias.
ExecStart=/usr/bin/step ca renew --force --expires-in ${JOCOTOCO_RENOVAR_ANTES} \
    /etc/jocotoco/tls/servidor.crt /etc/jocotoco/tls/servidor.key
ExecStartPost=/bin/chown root:jocotoco /etc/jocotoco/tls/servidor.crt /etc/jocotoco/tls/servidor.key
ExecStartPost=/bin/chmod 0640 /etc/jocotoco/tls/servidor.crt /etc/jocotoco/tls/servidor.key
# step ca renew devuelve 0 aunque no renueve; la recarga es idempotente.
ExecStartPost=/bin/systemctl reload apache2
SuccessExitStatus=0
